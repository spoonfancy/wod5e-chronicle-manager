<section class="wrt-tracker"><header class="wrt-header"><div><h2>Relationship Tracker</h2><p>NPC attitudes toward individual player characters.</p></div><button type="button" data-action="create"><i class="fas fa-plus"></i> New Relationship</button></header><div class="wrt-list">{{#if relationships.length}}{{#each relationships}}<article class="wrt-row"><img class="wrt-thumb" src="{{npcImg}}" alt=""><div class="wrt-names"><strong>{{npcName}}</strong><span>toward {{pcName}}</span></div><div class="wrt-data"><strong>{{attitude}}</strong><p>{{publicDescription}}</p></div><div class="wrt-actions"><button type="button" data-action="show" data-id="{{id}}">Show</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button><button type="button" data-action="delete" data-id="{{id}}">Delete</button></div></article>{{/each}}{{else}}<div class="wrt-empty"><p>No relationships have been created yet.</p><button type="button" data-action="create">Create the first relationship</button></div>{{/if}}</div></section>