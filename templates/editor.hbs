<form class="wrt-editor"><div class="form-group"><label>NPC</label><select name="npcId" required><option value="">Select NPC...</option>{{#each actors}}<option value="{{id}}" {{#if (eq ../relationship.npcId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><div class="form-group"><label>Player Character</label><select name="pcId" required><option value="">Select Player Character...</option>{{#each actors}}<option value="{{id}}" {{#if (eq ../relationship.pcId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><div class="form-group"><label>Attitude</label><select name="attitude" required>{{#each attitudes}}<option value="{{this}}" {{#if (eq ../relationship.attitude this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></div><div class="form-group"><label>Public Description</label><textarea name="publicDescription" rows="5">{{relationship.publicDescription}}</textarea></div><div class="form-group"><label>GM Notes</label><textarea name="privateNotes" rows="5">{{relationship.privateNotes}}</textarea></div><button type="submit">Save Relationship</button></form>